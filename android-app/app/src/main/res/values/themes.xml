<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HenKukaj" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@color/pozadie</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.HenKukaj.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tmava</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.HenKukaj</item>
    </style>
    <style name="Theme.HenKukaj.Nastavenia" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/oranzova</item>
        <item name="colorPrimaryDark">#C44C0A</item>
        <item name="colorAccent">@color/oranzova</item>
    </style>
</resources>
