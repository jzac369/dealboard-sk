@echo off
REM VZOR. Skopiruj tento subor na "telegram.env.cmd" a doplnaj hodnoty tam,
REM nie sem - tento vzor je v repozitari, ten druhy je v .gitignore.
REM
REM Token najdes u @BotFather, chat id ti povie @userinfobot.
REM Su to tie iste hodnoty, ktore mas v GitHub secrets.

set TELEGRAM_BOT_TOKEN=sem_pride_token
set TELEGRAM_CHAT_ID=sem_pride_chat_id
