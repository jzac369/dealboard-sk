// ═══════════════════════════════════════════════════════════════════════
//  PRAVIDLÁ NA PRIDANIE — Firebase Console → Firestore → Rules
// ═══════════════════════════════════════════════════════════════════════
//
//  POZOR: toto NIE JE celý súbor pravidiel. Sú to len tri nové bloky,
//  ktoré patria DOVNÚTRA existujúceho
//
//      match /databases/{database}/documents {
//          ... tvoje súčasné pravidlá zostávajú ...
//          <<< SEM VLOŽ TIETO TRI BLOKY >>>
//      }
//
//  Tvoje súčasné pravidlá sú dobre napísané (overil som ich útokom cez
//  verejné API — čítanie, zápis, mazanie aj obídenie moderácie boli
//  zablokované). Preto ich neprepisujem: nevidím ich a nechcem rozbiť
//  to, čo funguje.
//
//  Kým tieto bloky nevložíš, tri nové funkcie budú ticho nefunkčné:
//  správa predajcov, záznam zmien a meranie preklikov. Admin panel aj
//  stránka fungujú ďalej bez nich — všetko je ošetrené.
//
//  DÔLEŽITÉ: `jeAdmin()` nižšie je môj odhad. Pozri sa, ako si admina
//  overuješ v existujúcich pravidlách pri kolekcii `deals`, a použi
//  presne tú istú podmienku. Ak tam máš napríklad kontrolu konkrétneho
//  UID, nahraď ňou celé telo funkcie.
// ═══════════════════════════════════════════════════════════════════════


// Pomocná funkcia — over si ju podľa svojich existujúcich pravidiel!
function jeAdmin() {
  return request.auth != null
      && request.auth.token.email == 'foresttt11@outlook.com'
      && request.auth.token.firebase.sign_in_provider == 'password';
}


// ── 1. Predajcovia a ich odkazy ────────────────────────────────────────
// Spravuje ich len admin. Agent ich číta cez service account, ktorý
// pravidlá obchádza, takže verejné čítanie nie je potrebné.
match /merchants/{merchantId} {
  allow read, write: if jeAdmin();
}


// ── 2. Záznam zmien ────────────────────────────────────────────────────
// Zapisuje admin panel pri každej zmene stavu dealu.
// Úpravu a mazanie zakazujeme úplne — denník, ktorý sa dá prepísať,
// nie je denník.
match /audit_log/{entryId} {
  allow read:   if jeAdmin();
  allow create: if jeAdmin();
  allow update, delete: if false;
}


// ── 3. Prekliky na dealy ───────────────────────────────────────────────
// Toto je jediný blok, ktorý dovoľuje zápis bežnému návštevníkovi —
// inak by sa prekliky nedali merať.
//
// Riziká sú zámerne zúžené:
//  · zapisovať smie len prihlásený návštevník (aj anonymne)
//  · dokument smie obsahovať VÝHRADNE polia count a lastClick
//  · počítadlo sa smie zvýšiť presne o 1, nie skočiť na ľubovoľné číslo
//  · zmazať ani vynulovať ho nemôže nikto okrem admina
//
// Zostáva možnosť, že niekto klikaním umelo nafúkne číslo. Je to len
// štatistika pre teba, nie niečo, podľa čoho sa radí obsah, takže je to
// prijateľné. Keby to niekto zneužíval, dá sa zápis presunúť na Cloud
// Function s obmedzením podľa IP.
match /deal_clicks/{dealId} {
  allow read: if jeAdmin();

  allow create: if request.auth != null
             && request.resource.data.keys().hasOnly(['count', 'lastClick'])
             && request.resource.data.count == 1;

  allow update: if request.auth != null
             && request.resource.data.keys().hasOnly(['count', 'lastClick'])
             && request.resource.data.count == resource.data.count + 1;

  allow delete: if jeAdmin();
}
